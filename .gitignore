# Python
__pycache__/
*.pyc
.venv/
.pytest_cache/

# Node - at any depth (frontend/ and siren-app/ both have one)
node_modules/
frontend/dist/

# Android build output and machine-specific SDK paths
siren-app/android/build/
siren-app/android/app/build/
siren-app/android/.gradle/
siren-app/android/local.properties
siren-app/android/.idea/
*.iml

# Runtime / generated data (job outputs, uploads, per-job artifacts)
jobs/
outputs/
references/
zones/

# Uploaded footage is runtime data, except the small demo clips the two
# built-in cameras run on - without them a fresh clone has no cameras.
uploads/*
!uploads/smoke_*.mp4

# Model weights are committed (46MB). They are small, they pin the exact
# versions every measurement here was taken against, and a clone that has to
# hunt down four model files from three projects is a clone that does not run.

# Editor / OS
.claude/
.vscode/
.DS_Store
Thumbs.db

# Env
.env
.env.local

# Local-only helper deps (PDF generation)
pylibs/

# Dev TLS certificate (generated locally, never commit)
certs/

# Runtime state. Holds the token signing key, the password hashes and the
# event database - publishing any of them would let anyone forge a session.
# The directory is recreated on startup, so nothing here belongs in source.
data/
